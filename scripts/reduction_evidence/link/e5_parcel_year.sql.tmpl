\copy (with k(sgg,bjd,lt,bun,ji) as (values {KEYS}) select e.sigungu_code, e.bjdong_code, e.lot_type, e.bun, e.ji, left(e.use_ym,4) y, e.energy_type, e.source, count(e.usage_kwh) months, sum(e.usage_kwh) kwh from energy_monthly e join k on k.sgg=e.sigungu_code and k.bjd=e.bjdong_code and k.lt=e.lot_type and k.bun=e.bun and k.ji=e.ji group by 1,2,3,4,5,6,7,8 order by 1,2,3,4,5,6,7) to stdout with csv header
